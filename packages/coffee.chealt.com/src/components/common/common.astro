---
import Admin from "../admin/admin.astro";
import Analytics from "./analytics.astro";
import I18NContainer from "../i18n/container.astro";
import Login from "../login/login.astro";
import Nav from "./nav/nav.astro";
import Recommendations from "./recommendations.astro";
import TranslationBanner from "../i18n/banner.astro";

import loaderImage from "./loader.svg";

import { getTranslator } from "@components/i18n/t.js";

import "./common.css";

const t = await getTranslator({
  filePath: "common",
  locale: Astro.currentLocale,
});

const { shouldAuthenticate, redirectUrl, title, hideNav = false } = Astro.props;
const { canTranslate, isTranslating } = Astro.locals;
const isAdmin = canTranslate;

const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#e1a76d" />
    <meta name="description" content={t("description")} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/favicons/favicon-192x192.svg" />
    <title>{title ? `${title} | ${t("title")}` : t("title")}</title>
    <script is:inline>
      window.addEventListener("pagereveal", (event) => {
        if (window.navigation.activation?.navigationType === "traverse") {
          const viewTransitionName =
            sessionStorage.getItem("viewTransitionName");

          if (viewTransitionName) {
            /** @type {HTMLElement | null} */
            const element = document.querySelector(
              `[data-view-transition-name="${viewTransitionName}"]`,
            );

            if (element) {
              element.style.viewTransitionName = viewTransitionName;
              sessionStorage.removeItem("viewTransitionName");
            }
          }
        } else if (event.viewTransition && window.navigation.activation?.from) {
          const previousUrl = window.navigation.activation.from.url;
          const matches = previousUrl?.match(
            /\/collections\/([0-9a-zA-Z-]*)\/items\/([0-9a-zA-Z-]*)\//,
          );

          if (previousUrl && matches) {
            const collectionId = matches[1];
            const itemId = matches[2];

            /** @type {HTMLElement | null} */
            const transitionTargetElement = document.querySelector(
              `[data-selector="collection-id-${collectionId}"] #item-id-${itemId} picture`,
            );

            if (transitionTargetElement) {
              transitionTargetElement.scrollIntoView({
                behavior: "instant",
                block: "center",
              });

              transitionTargetElement.style.viewTransitionName =
                "collectionItemCoverImage";
            }
          }
        }
      });
    </script>
  </head>
  <body>
    <chealt-view-transitions>
      {isAdmin && <Admin />}
      {isTranslating && <I18NContainer locale={Astro.currentLocale} />}
      <chealt-data>
        {isTranslating && <TranslationBanner />}
        <Recommendations>
          <main class={Astro.props.class}>
            {
              shouldAuthenticate ? (
                <Login redirectUrl={redirectUrl} />
              ) : (
                <slot />
              )
            }
          </main>
        </Recommendations>
        {!hideNav && <Nav />}
      </chealt-data>
      <img src={loaderImage.src} class="visually-hidden" aria-hidden="true" />
      {isProd && <Analytics />}
    </chealt-view-transitions>
  </body>
</html>

<script src="./service-worker-init.js"></script>
<script src="../chealt-data.js"></script>
<script src="../chealt-view-transitions.js"></script>
