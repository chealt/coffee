---
import Admin from "../admin/admin.astro";
import Analytics from "./analytics.astro";
import I18NContainer from "../i18n/container.astro";
import Login from "../login/login.astro";
import Nav from "./nav/nav.astro";
import Recommendations from "./recommendations.astro";
import TranslationBanner from "../i18n/banner.astro";

import loaderImage from "./loader.svg";

import { getTranslator } from "@components/i18n/t.js";

import "./common.css";

const t = await getTranslator({
  filePath: "common",
  locale: Astro.currentLocale,
});

const { shouldAuthenticate, redirectUrl, title, hideNav = false } = Astro.props;
const { canTranslate, isTranslating } = Astro.locals;
const isAdmin = canTranslate;

const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#e1a76d" />
    <meta name="description" content={t("description")} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/favicons/favicon-192x192.svg" />
    <title>{title ? `${title} | ${t("title")}` : t("title")}</title>
    <script is:inline>
      window.addEventListener("pagereveal", (event) => {
        const activation = window.navigation?.activation;
        const viewTransition = event.viewTransition;

        if (!viewTransition || !activation?.from) {
          return;
        }

        // hide elements while in transition
        document
          .querySelectorAll("[data-hide-while-transitioning]")
          .forEach((e) => e.classList.add("hidden"));

        // reveal elements that were hidden while in transition
        viewTransition.finished.then(() => {
          document
            .querySelectorAll("[data-hide-while-transitioning]")
            .forEach((e) => e.classList.remove("hidden"));
        });

        // the element to animate is the one linking to the page we came from
        const previousPath = new URL(activation.from.url).pathname;
        const link = [...document.querySelectorAll("a[href]")].find(
          (a) => new URL(a.href).pathname === previousPath,
        );

        /** @type {HTMLElement | undefined | null} */
        const element = link?.querySelector("[data-view-transition-name]");
        const viewTransitionName = element?.dataset.viewTransitionName;

        if (!element || !viewTransitionName) {
          return;
        }

        // traversals restore the scroll position on their own
        if (activation.navigationType !== "traverse") {
          element.scrollIntoView({ behavior: "instant", block: "center" });
        }

        element.style.viewTransitionName = viewTransitionName;

        viewTransition.finished.then(() => {
          element.style.viewTransitionName = "none";
        });
      });
    </script>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker?.addEventListener("message", (event) => {
          if (event.data?.action === "reload-page") {
            window.location.reload();
          }
        });
      }
    </script>
  </head>
  <body>
    <chealt-view-transitions>
      {isAdmin && <Admin />}
      {isTranslating && <I18NContainer locale={Astro.currentLocale} />}
      <chealt-data>
        {isTranslating && <TranslationBanner />}
        <Recommendations>
          <main class={Astro.props.class}>
            {
              shouldAuthenticate ? (
                <Login redirectUrl={redirectUrl} />
              ) : (
                <slot />
              )
            }
          </main>
        </Recommendations>
        {!hideNav && <Nav />}
      </chealt-data>
      <img src={loaderImage.src} class="visually-hidden" aria-hidden="true" />
      {isProd && <Analytics />}
    </chealt-view-transitions>
  </body>
</html>

<script src="./service-worker-init.js"></script>
<script src="../chealt-data.js"></script>
<script src="../chealt-view-transitions.js"></script>
