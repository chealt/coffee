---
import { getRelativeLocaleUrl } from "astro:i18n";

import exchangeRates from "@data/exchangeRates.json" with { type: "json" };
import supportedLanguages from "@data/supportedLanguages.json" with { type: "json" };

import APIButton from "@components/common/api-button.astro";
import T from "@components/i18n/t.astro";
import { getTranslator } from "@components/i18n/t.js";
import Button from "@components/form/button/button.astro";
import Common from "@components/common/common.astro";
import Form from "@components/form/form.astro";
import Icon from "@components/icon/icon.astro";
import Label from "@components/form/label/label.astro";
import Logout from "@components/logout/logout.astro";
import Select from "@components/form/select/select.astro";
import Toggle from "@components/form/toggle/toggle.astro";
import { capitalize } from "../../../utils/string.js";

const t = await getTranslator({
  filePath: "you/profile",
  locale: Astro.currentLocale,
});

const {
  shouldAuthenticate,
  canTranslate,
  currency: selectedCurrency,
  isAdmin,
  settings,
} = Astro.locals;

const currencies = exchangeRates.map(({ currency_code }) => currency_code);
---

<Common
  shouldAuthenticate={shouldAuthenticate}
  redirectUrl={getRelativeLocaleUrl(Astro.currentLocale, "/you/profile")}
>
  <h1>
    <span><T namespace="you.profile.locales" key="title">{t("title")}</T></span>
    <Button
      href={getRelativeLocaleUrl(Astro.currentLocale, "/you/collections")}
      class="ghost small"
    >
      <Icon type="back" />
      <span class="visually-hidden">
        <T namespace="you.profile.locales" key="back">{t("back")}</T>
      </span>
    </Button>
  </h1>
  <section>
    <Form
      name="settings"
      data-storage="api"
      data-save-endpoint="/api/storage/save-form-data"
      data-save-on-input
      data-exclude-from-local-storage
    >
      <p data-error-code="RATE_LIMIT_EXCEEDED" class="error hidden">
        <T namespace="you.profile.locales" key="rateLimitExceeded">
          {t("rateLimitExceeded")}
        </T>
      </p>
      <Label>
        <div class="name">
          <T namespace="you.profile.locales" key="language">
            {t("language")}
          </T>
        </div>
        <Select name="language">
          {
            supportedLanguages.map(({ locale, label }) => (
              <option value={locale} selected={locale === Astro.currentLocale}>
                {capitalize(label)}
              </option>
            ))
          }
        </Select>
      </Label>
      <Label>
        <div class="name">
          <T namespace="you.profile.locales" key="currency">
            {t("currency")}
          </T>
        </div>
        <Select name="currency">
          {
            currencies.map((currency) => (
              <option value={currency} selected={currency === selectedCurrency}>
                {currency}
              </option>
            ))
          }
        </Select>
      </Label>
      {
        canTranslate && (
          <chealt-i18n-toggle>
            <Toggle
              name="isTranslating"
              value="on"
              checked={settings?.isTranslating === "on"}
              data-translating-toggle
            >
              <T namespace="you.profile.locales" key="isTranslating">
                {t("isTranslating")}
              </T>
            </Toggle>
          </chealt-i18n-toggle>
        )
      }
      <fieldset>
        <legend>
          <div class="name">
            <T namespace="you.profile.locales" key="notifications">
              {t("notifications")}
            </T>
          </div>
        </legend>
        <Toggle
          name="newCoffeeNotification"
          value="on"
          checked={settings?.newCoffeeNotification === "on"}
        >
          <T namespace="you.profile.locales" key="newCoffee">
            {t("newCoffee")}
          </T>
        </Toggle>
      </fieldset>
      <APIButton
        apiEndpoint="/api/authentication/registration/send-new-code.json?profile"
      >
        <Button class="bordered column">
          <span>
            <T namespace="you.profile.locales" key="sendRegistrationCode">
              {t("sendRegistrationCode")}
            </T>
          </span>
          <Icon type="email" />
        </Button>
      </APIButton>
    </Form>
  </section>
  <section>
    <Button
      class="bordered column"
      href={getRelativeLocaleUrl(Astro.currentLocale, "/you/profile/passkeys")}
    >
      <span>
        <T namespace="you.profile.locales" key="passkeys">
          {t("passkeys")}
        </T>
      </span>
      <Icon type="user" />
    </Button>
  </section>
  {
    isAdmin && (
      <section>
        <Button
          class="bordered column"
          href={getRelativeLocaleUrl(Astro.currentLocale, "/you/admin")}
        >
          <span>
            <T namespace="you.profile.locales" key="admin">
              {t("admin")}
            </T>
          </span>
        </Button>
      </section>
    )
  }
  <section>
    <Logout logoutUrl="/api/authentication/logout.json">
      <Button class="danger column" data-logout-trigger>
        <Icon type="power" />
        <span>
          <T namespace="you.profile.locales" key="logout">
            {t("logout")}
          </T>
        </span>
      </Button>
    </Logout>
  </section>
</Common>

<script src="../../i18n/translating-toggle.js"></script>
