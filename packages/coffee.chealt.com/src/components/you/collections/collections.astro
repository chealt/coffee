---
import { getRelativeLocaleUrl } from "astro:i18n";

import brewingMethods from "@data/brewingMethods.json" with { type: "json" };
import roasters from "@data/roasters.json" with { type: "json" };

import CoffeeImageUpload from "@components/common/coffee-image-upload.astro";
import Common from "@components/common/common.astro";
import Dialog from "@components/dialog/dialog.astro";
import Button from "@components/form/button/button.astro";
import Checkbox from "@components/form/checkbox/checkbox.astro";
import Form from "@components/form/form.astro";
import Icon from "@components/icon/icon.astro";
import { getTasteNoteGroupByNoteId } from "@components/taste-notes/utils.js";

import Filters from "./filters/filters.astro";
import Header from "./header/header.astro";
import NewCollection from "./new-collection.astro";
import NewItem from "./new-item.astro";

import T from "@components/i18n/t.astro";
import { getTranslator } from "@components/i18n/t.js";

import "./collections.css";
import "./transition.css";

const t = await getTranslator({
  filePath: "you/collections",
  locale: Astro.currentLocale,
});

const { collections, collectionsControls, shouldAuthenticate, username } =
  Astro.locals;

const {
  brewingMethodId,
  brewingMethodGroupId,
  countryId,
  originCountryId,
  processingMethodId,
  roasterId,
  tasteNoteGroupId,
  tasteNoteId,
  varietyId,
} = Astro.props;

const brewingMethodIdsInGroup =
  brewingMethodGroupId &&
  brewingMethods
    .filter(
      ({ brewing_method_group_id }) =>
        !brewing_method_group_id ||
        brewing_method_group_id === brewingMethodGroupId,
    )
    .map(({ brewing_method_id }) => String(brewing_method_id));

const showCoffee = ({ details }) => {
  if (!details) {
    return true;
  }

  return (
    (!brewingMethodId || String(brewingMethodId) === details.brewingMethod) &&
    (!brewingMethodGroupId ||
      brewingMethodIdsInGroup.includes(details.brewingMethod)) &&
    (!countryId ||
      roasters.find(({ id }) => String(id) === details.roaster)?.country_id ===
        countryId) &&
    (!originCountryId || String(originCountryId) === details.originCountry) &&
    (!processingMethodId ||
      String(processingMethodId) === details.processingMethod) &&
    (!roasterId || String(roasterId) === details.roaster) &&
    (!tasteNoteGroupId ||
      details["tasteNoteIds[]"]?.some(
        (id) =>
          getTasteNoteGroupByNoteId(Number(id))?.taste_note_group_id ===
          tasteNoteGroupId,
      )) &&
    (!varietyId ||
      details["varieties[]"]?.some((id) => String(varietyId) === id))
  );
};
---

<Common
  htmlClass="collections-page"
  shouldAuthenticate={shouldAuthenticate}
  redirectUrl={getRelativeLocaleUrl(Astro.currentLocale, "/you/collections")}
>
  <chealt-toggle>
    <header class="title">
      <h1>
        <T namespace="you.collections.locales" key="title">{t("title")}</T>
      </h1>
      <Button
        class="ghost small column inline"
        data-trigger-selector=".filters-container"
      >
        <Icon type="search" />
        {t("filter")}
      </Button>
      <Button class="small" data-trigger-selector=".collections-controls">
        <Icon type="bottom-panel" />
      </Button>
      <Button
        class="round bordered small profile"
        href={getRelativeLocaleUrl(Astro.currentLocale, "/you/profile")}
      >
        <Icon type="user" />
        <span class="visually-hidden">{username}</span>
      </Button>
    </header>
    <div class="collections-controls collections-hidden-header">
      <Form
        name="collectionsControls"
        data-storage="api"
        data-save-endpoint="/api/storage/save-form-data"
        data-save-on-input
        data-exclude-from-local-storage
      >
        <Checkbox name="showAge" checked={collectionsControls?.showAge}>
          <T namespace="you.collections.locales" key="showAge">{t("showAge")}</T
          >
        </Checkbox>
        <Checkbox
          name="showArchived"
          checked={collectionsControls?.showArchived}
        >
          <T namespace="you.collections.locales" key="showArchived"
            >{t("showArchived")}</T
          >
        </Checkbox>
      </Form>
    </div>
    <Filters
      brewingMethodId={brewingMethodId}
      brewingMethodGroupId={brewingMethodGroupId}
      countryId={countryId}
      originCountryId={originCountryId}
      processingMethodId={processingMethodId}
      roasterId={roasterId}
      tasteNoteGroupId={tasteNoteGroupId}
      tasteNoteId={tasteNoteId}
      varietyId={varietyId}
    />
  </chealt-toggle>
  <coffee-collection>
    <ul
      class="collections-list"
      data-delete-confirm-message={t("deleteCollection.confirm")}
    >
      {
        collections?.map(
          ({ id: collectionId, name, items, isBuiltIn, weight }, index) => (
            <li
              id={collectionId}
              data-selector={`collection-id-${collectionId}`}
              data-type="collection"
            >
              <Header
                collectionId={collectionId}
                name={t(collectionId) || name}
                isBuiltIn={isBuiltIn}
                isFirst={index === 0}
                isLast={index === collections.length - 1}
                weight={weight}
              />
              <ul class="tiles items-list">
                {items.length ? (
                  items
                    .filter(showCoffee)
                    .map(({ id: itemId, cover, details, isDeleted }) => (
                      <li class={`${(isDeleted && "archived") || ""}`}>
                        <a
                          href={`${getRelativeLocaleUrl(
                            Astro.currentLocale,
                            `/you/collections/${collectionId}/items/${itemId}?from=${Astro.url.pathname.replace(`/${Astro.currentLocale}`, "")}`,
                          )}`}
                          id={`item-id-${itemId}`}
                        >
                          <img
                            src={cover.srcSmall}
                            loading="lazy"
                            data-view-transition-name="collectionItemCoverImage"
                          />
                        </a>
                        {details && !details?.isBrewed && (
                          <div class="fade-in" data-hide-while-transitioning>
                            {(details?.isStillFrozen && !details?.isBrewed && (
                              <div class="tag bottom frozen">
                                <Icon class="small" type="snowflake" />
                                <span>{details.daysFrozen}</span>
                              </div>
                            )) ||
                              (details?.daysSinceRoasting && (
                                <div class="tag bottom">
                                  <Icon class="small" type="alarm" />
                                  <span>{details.daysSinceRoasting}</span>
                                </div>
                              ))}
                          </div>
                        )}
                      </li>
                    ))
                ) : (
                  <NewItem collectionId={collectionId} />
                )}
              </ul>
            </li>
          ),
        )
      }
    </ul>
    <div class="drawer top" id="batch-update" popover="manual">
      <ul>
        <li>
          <Button class="ghost column" data-dialog-id="edit-collections">
            <Icon type="edit" />
            <T namespace="you.collections.locales" key="editCollection">
              {t("editCollection")}
            </T>
          </Button>
        </li>
        <li>
          <Button class="ghost column" data-mark-as-brewed-trigger>
            <T namespace="you.collections.locales" key="markAsBrewed">
              {t("markAsBrewed")}
            </T>
          </Button>
        </li>
        <li>
          <Button class="ghost column" data-delete-collection-items-trigger>
            <Icon type="delete" />
            <T namespace="you.collections.locales" key="delete">
              {t("delete")}
            </T>
          </Button>
        </li>
        <li>
          <Button class="ghost column warning" data-clear-trigger>
            <Icon type="close" />
            <T namespace="you.collections.locales" key="clearSelection"
              >{t("clearSelection")}</T
            >
          </Button>
        </li>
      </ul>
    </div>
    <Dialog class="drawer" id="edit-collections" reloadOnChange>
      <ul>
        {
          collections?.map(({ id, name }) => (
            <li>
              <Checkbox name={id} value={id}>
                {name}
              </Checkbox>
            </li>
          ))
        }
      </ul>
    </Dialog>
  </coffee-collection>
  <NewCollection />
  <CoffeeImageUpload data-unnamed-title={t("unnamedTitle")}>
    <Button class="triggerButton bottom right floating primary">
      <Icon class="icon" type="capture" />
      <span class="visually-hidden">
        <T namespace="common.nav.locales" key="capture">
          {t("capture")}
        </T>
      </span>
    </Button>
  </CoffeeImageUpload>
</Common>

<script src="./coffee-collection.js"></script>
<script src="../../toggle/toggle.js"></script>
