---
import { getRelativeLocaleUrl } from "astro:i18n";

import { titleCase } from "../../../../../utils/string.js";
import Label from "../../../../form/label/label.astro";
import Select from "../../../../form/select/select.astro";

import originFarms from "../../../../../../data/originFarms.json" with { type: "json" };

import T from "@components/i18n/t.astro";
import { getTranslator } from "@components/i18n/t.js";

const t = await getTranslator({
  filePath: "you/collections/item/details",
  locale: Astro.currentLocale,
});

const { selected, originCountry, originRegion } = Astro.props;
---

<Label>
  <div class="name">
    <T namespace="you.collections.item.details.locales" key="originFarm"
      >{t("originFarm")}</T
    >
  </div>
  <Select
    name="originFarm"
    showEmpty
    data-update-keys="[name='originCountry'],[name='originRegion']"
    data-api-endpoint={getRelativeLocaleUrl(
      Astro.currentLocale,
      "/origin-farms",
    )}
  >
    {
      originFarms
        .filter(
          ({ origin_country_id, origin_region_id }) =>
            (!originCountry ||
              String(originCountry) === String(origin_country_id)) &&
            (!originRegion ||
              String(originRegion) === String(origin_region_id)),
        )
        .map(({ id, name }) => (
          <option value={id} selected={String(id) === String(selected)}>
            {titleCase(name)}
          </option>
        ))
    }
  </Select>
</Label>
